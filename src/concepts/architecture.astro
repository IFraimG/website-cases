---
import SiteNav from "../components/SiteNav.astro";
import SiteExploreStrip from "../components/SiteExploreStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Base from "../layouts/Base.astro";
import Detail from "../components/Detail.astro";
import { getSite } from "../data/sites";
const site = getSite("architecture");
const projects = [
  {
    name: "Дом на просвет",
    file: "house",
    type: "Частная архитектура",
    info: "214 м² · Московская область",
    text: "Две части дома соединяет светлая гостиная. Утром солнце проходит вдоль длинной стены, а к вечеру уходит в глубину террасы. Приватные комнаты собраны вокруг короткого внутреннего маршрута.",
  },
  {
    name: "Внутренний двор",
    file: "courtyard",
    type: "Жилая среда",
    info: "680 м² · Подмосковье",
    text: "Двор работает как ещё одна общая комната. Низкая посадка и тихие проходы по периметру оставляют центральную площадку свободной для встреч.",
  },
  {
    name: "Точка тишины",
    file: "pavilion",
    type: "Малые формы",
    info: "96 м² · Тверская область",
    text: "Небольшое пространство для отдыха. Простая геометрия удерживает масштаб участка, а глубокие проёмы кадрируют виды и дают тень в полдень.",
  },
];
const path = (f: string) => "/media/architecture/" + f + ".webp";
---

<Base legacy title="Межа — архитектурное бюро" theme="arch"
  ><SiteNav site={site} active="home" />
  <main id="content" class="wrap">
    <section class="a-hero">
      <div class="a-heading">
        <h1>Дом на <em>просвет</em></h1><p>
          Частная архитектура<br />Московская область · 214 м²
        </p>
      </div><div class="a-cover">
        <img
          src={path("house")}
          alt="Архитектура частного дома, вид с участка"
        /><button data-dialog="project-0" class="btn">Открыть проект</button>
      </div>
    </section>
    <section id="bureau" class="section a-note">
      <p class="meta">О бюро</p><div>
        <h2>От границы участка<br />до ручки двери.</h2><p class="lead">
          «Межа» проектирует дома, где ландшафт, свет и привычки хозяев
          определяют каждое решение.
        </p>
      </div>
    </section>
    <section id="work" class="section rule">
      <h2 class="head">Избранные работы</h2><div class="gallery">
        {
          projects.map((p, i) => (
            <article>
              <button class="project" data-dialog={"project-" + i}>
                <>
                  <img src={path(p.file)} alt={p.name} />
                  <span class="meta">{p.type}</span>
                  <h3>{p.name}</h3>
                  <small>{p.info}</small>
                </>
              </button>
            </article>
          ))
        }
      </div>
    </section>
    <section class="section rule a-note">
      <span class="meta">Материалы</span><div class="stack">
        <h2>Фактура в масштабе руки</h2><p class="lead">
          Для фасада собираем образцы в натуральную величину. Смотрим на стык
          камня и дерева после дождя, проверяем цвет в тени и на солнце.
        </p>
      </div>
    </section>
    <section class="section rule">
      <h2 class="head">Путь проекта</h2><div class="grid3">
        {
          [
            ["Участок", "Изучаем рельеф, стороны света и видовые оси."],
            ["Эскиз", "Сверяем варианты планировки с распорядком семьи."],
            [
              "Реализация",
              "Передаём строителям чертежи и проверяем детали на объекте.",
            ],
          ].map(([t, d]) => (
            <div class="stack">
              <>
                <h3>{t}</h3>
                <p>{d}</p>
              </>
            </div>
          ))
        }
      </div>
    </section>
    {
      projects.map((p, i) => (
        <Detail
          id={"project-" + i}
          title={p.name}
          photo={path(p.file)}
          alt={p.type}
          info={p.info}
          description={p.text}
        />
      ))
    }
  </main><SiteExploreStrip site={site} /><SiteFooter site={site} /></Base
>
<style is:global>
  .arch {
    --paper: #f5f3ed;
    --ink: #332f27;
  }
  .arch :is(h1, h2, h3, .word) {
    font-family: "PT Serif", Georgia, serif;
    font-weight: 400;
  }
  .word {
    font-size: 2.7rem;
    letter-spacing: -0.09em;
  }
  .word span {
    font: 12px Arial;
    vertical-align: top;
    color: #ad482f;
  }
  .a-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding: 3.7rem 0 1.7rem;
  }
  .a-heading h1 {
    font-size: clamp(3.7rem, 8.7vw, 9rem);
  }
  .a-heading em {
    color: #83513b;
  }
  .a-cover {
    position: relative;
  }
  .a-cover img {
    height: clamp(340px, 43vw, 630px);
  }
  .a-cover .btn {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    background: #fff;
    color: #302c27;
  }
  .a-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
  }
  .a-note p.lead {
    margin-top: 1.6rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4vw;
  }
  @media (min-width: 721px) {
    .gallery article:first-child {
      grid-row: span 2;
      align-self: center;
    }
    .gallery article:first-child img {
      aspect-ratio: 0.94;
    }
  }
  .gallery article:nth-child(2) {
    padding-top: 2vw;
  }
  .gallery article:last-child {
    grid-column: 2;
  }
  .project {
    display: block;
    text-align: left;
    width: 100%;
    padding: 0;
  }
  .project img {
    aspect-ratio: 1.52;
    margin-bottom: 1rem;
  }
  .project h3 {
    margin: 0.45rem 0;
  }
  .arch small {
    font-size: 0.93rem;
  }
  @media (max-width: 720px) {
    .descriptor {
      display: none;
    }
    .a-heading {
      display: block;
      padding: 2.5rem 0 1rem;
    }
    .a-heading p {
      margin-top: 1rem;
    }
    .a-note,
    .gallery {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .gallery article:last-child {
      grid-column: auto;
    }
    .gallery article:nth-child(2) {
      padding: 0;
    }
    .a-cover img {
      height: 370px;
    }
    .word {
      font-size: 2.3rem;
    }
  }
</style>
